<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AdoptPet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item
            name="android:windowLightNavigationBar"
            tools:targetApi="27">true</item>
    </style>

    <style name="Theme.AdoptPet" parent="Base.Theme.AdoptPet" />

    <style name="ThemeOverlay.AdoptPet.Toolbar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="actionMenuTextColor">@color/home_primary</item>
        <item name="android:textColorPrimary">@color/home_primary</item>
        <item name="android:textColorSecondary">@color/home_primary</item>
        <item name="colorControlNormal">@color/home_primary</item>
    </style>
</resources>
